{
  "_comment": "Cutscene schema (ENGINEERING_CONSTRAINTS.md §8). Beats are data; actors are node paths resolved at play time against the trigger's actor root. 'emit' fires a named signal a scene may hook — JSON never calls scripts. 'stagger' is the world-break reaction (Docs/WEIRDNESS_SPEC.md §5, ledger M-5); `overt: true` on it also fires Good Soil (Probably)'s tell before the beat.",
  "title": "cutscene",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "skippable", "once", "beats"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "skippable": { "type": "boolean" },
    "once": { "type": "boolean" },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["wait", "move", "animation", "dialogue", "end", "set_flag", "camera", "fade", "sfx", "spawn", "despawn", "choice", "emit", "stagger"]
          },
          "overt": { "type": "boolean" },
          "duration": { "type": "number", "minimum": 0 },
          "node": { "type": "string" },
          "target": { "type": "array", "items": { "type": "number" } },
          "position": { "type": "array", "items": { "type": "number" } },
          "speed": { "type": "number", "minimum": 0 },
          "animation": { "type": "string" },
          "dialogue_id": { "type": "string" },
          "flag": { "type": "string" },
          "value": {},
          "increment": { "type": "integer" },
          "action": { "type": "string", "enum": ["pan", "shake"] },
          "amplitude": { "type": "number", "minimum": 0 },
          "to": { "type": "string", "enum": ["black", "clear"] },
          "stream": { "type": "string" },
          "scene": { "type": "string" },
          "name": { "type": "string" },
          "signal": { "type": "string" },
          "args": { "type": "array" }
        }
      }
    }
  }
}
