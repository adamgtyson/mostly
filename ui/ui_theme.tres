[gd_resource type="Theme" load_steps=7 format=3]

; Shared UI theme (session 10). The project renders menus inside the 320x180
; canvas, so everything here is sized for a 180px-tall screen: the dialogue
; box's default font at size 8 (no font files while EC-12a is OPEN), buttons
; well under 16px tall with 4px/2px padding, and a visible focus border so
; keyboard/gamepad selection reads at 4x window scale. Palette matches the
; dialogue box: near-black panels, grey borders, brighter border on focus.

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_button_normal"]
content_margin_left = 4.0
content_margin_top = 2.0
content_margin_right = 4.0
content_margin_bottom = 2.0
bg_color = Color(0.08, 0.08, 0.12, 0.95)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.55, 0.55, 0.65, 1)

