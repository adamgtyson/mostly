; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mostly"
run/main_scene="res://scenes/workshop.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
[autoload]

Boot="*res://scripts/boot.gd"
GameState="*res://scripts/game_state.gd"
SaveManager="*res://scripts/save_manager.gd"
Inventory="*res://scripts/inventory.gd"
DialogueManager="*res://scripts/dialogue_manager.gd"
CutsceneManager="*res://scripts/cutscene_manager.gd"
CutsceneSkip="*res://scripts/cutscene_skip.gd"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

textures/canvas_textures/default_texture_filter=0
